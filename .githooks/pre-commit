#!/bin/bash

echo "🔍 Vérification du code avant commit..."

# Vérifie que DDEV est démarré
if ! ddev status >/dev/null 2>&1; then
    echo "⚠️  DDEV n'est pas démarré. Démarre-le avec : ddev start"
    exit 1
fi

# Récupère les fichiers PHP modifiés dans custom
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$\|\.module$\|\.install$\|\.inc$\|\.profile$\|\.theme$' | grep -E 'web/(modules|themes)/custom')

if [ -z "$FILES" ]; then
    echo "✅ Aucun fichier PHP custom à vérifier"
    exit 0
fi

echo "Fichiers à analyser :"
echo "$FILES"
echo ""

# 1. PHPCS via DDEV (avec toutes les dépendances)
echo "📋 Vérification PHPCS (standards Drupal)..."
ddev exec vendor/bin/phpcs --standard=Drupal,DrupalPractice $FILES

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ PHPCS a détecté des erreurs de style !"
    echo "💡 Correction automatique : ddev exec vendor/bin/phpcbf --standard=Drupal,DrupalPractice <fichiers>"
    echo "   ou bypass : git commit --no-verify"
    exit 1
fi

echo "✅ PHPCS : OK"
echo ""

# 2. PHPStan (analyse statique via DDEV)
echo "🔍 Analyse PHPStan..."
ddev exec vendor/bin/phpstan analyse $FILES --no-progress --error-format=table 2>/dev/null

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ PHPStan a détecté des erreurs !"
    echo "   Corrige-les ou bypass avec : git commit --no-verify"
    exit 1
fi

echo "✅ PHPStan : OK"
echo ""
echo "🎉 Toutes les vérifications sont passées !"
exit 0