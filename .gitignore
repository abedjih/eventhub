# gitignore template for Drupal 8 projects
#
# earlier versions of Drupal are tracked in `community/PHP/`

# Ignore configuration files that may contain sensitive information, by ignoring
# all files under '/web/sites', but allow '/web/sites/*/*.settings.php' files,
# specific to each environment, such as 'dev.settings.php'.
#/web/sites
/web/sites/*/settings*.php
/web/sites/*/default.settings.php
/web/sites/*/*services.yml
# Keep a common settings.php file versioned.
!/web/sites/*/settings.php
!/web/sites/*/settings.local.php

# Ignore paths that may contain user-generated content
/logs
/files_private
/private
/project_data
/web/sites/*/files
/web/sites/*/public
/web/sites/*/private
/web/sites/*/files-public
/web/sites/*/files-private

# Ignore paths that may contain temporary files
/web/sites/*/translations
/web/sites/*/tmp
/web/sites/*/cache

# Ignore testing related files
/web/sites/simpletest

# Ignore Behat screenshot and test files
/behat.yml
/features/screenshots/*
/testing/phpunit/browser_output/
/testing/behat/report/
/web/behat/report/

# Ignore Cypress test results files
/testing/e2e/node_modules/
/testing/e2e/cypress/results/
/testing/e2e/cypress/screenshots/
/testing/e2e/cypress/merged-report.json
/testing/e2e/mochawesome-report/

# Ignore drupal core (if not versioning drupal sources)
# Ignore Drupal scaffold files generated by composer
/web/core
/web/libraries/
/web/modules/README.txt
/web/modules/contrib/
/web/profiles/README.txt
/web/profiles/contrib/
/web/README.md
/web/sites/README.txt
/web/sites/example.sites.php
/web/sites/example.settings.local.php
/web/sites/development.services.yml
/web/themes/README.txt
/web/themes/contrib/
/web/.csslintrc
/web/.eslintignore
/web/.eslintrc.json
/web/.gitignore
/web/.ht.router.php
/web/.htaccess
/web/autoload.php
/web/example.gitignore
/web/index.php
/web/INSTALL.txt
/web/README.txt
/web/robots.txt
/web/update.php
/web/web.config

/drush/contrib/
/drush/drush.yml
/vendor
/.editorconfig
/.gitattributes
#/composer.json
#/composer.lock

# Ignore Node modules
/node_modules
/web/themes/custom/*/node_modules
/web/themes/custom/*/*/style.css.map

# Ignore editors files
/.buildpath
/.project
/.settings
/*.code-workspace
/.idea

# Ignore environment variables config file.
/.env

# Ignore sonar scan
/web/.scannerwork

# Local DB dumps and backups.
/db-backups
/dump_*
/**/*.sql
.ddev/importdb

