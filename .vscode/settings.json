{
  // =========================
  // PHP Local
  // =========================
  "php.validate.enable": true,
  "php.validate.executablePath": "/usr/bin/php",

  // =========================
  // PHPCS Local (plus de wrapper DDEV !)
  // =========================
  "phpcs.enable": true,
  "phpcs.executablePath": "vendor/bin/phpcs",
  "phpcs.standard": "Drupal,DrupalPractice",
  "phpcs.showSources": true,
  "phpcs.showWarnings": true,
  "phpcs.showErrors": true,
  "phpcs.autoExecute": true,
  "phpcs.ignorePatterns": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/web/core/**",
    "**/sites/default/files/**",
    "**/sites/*/files/**"
  ],


  // =========================
  // Formatage
  // =========================
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.defaultFormatter": null,

  "[php]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "editor.defaultFormatter": null,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [80]
  },

  // =========================
  // Intelephense
  // =========================
  "intelephense.format.braces": "k&r",
  "intelephense.environment.phpVersion": "8.3",
  "php.suggest.basic": false,
  "intelephense.files.exclude": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/sites/default/files/**",
    "**/sites/*/files/**",
    "**/web/core/**"
  ],
  "intelephense.stubs": [
    "apache",
    "bcmath",
    "Core",
    "curl",
    "date",
    "dom",
    "fileinfo",
    "filter",
    "gd",
    "hash",
    "json",
    "libxml",
    "mbstring",
    "mysqli",
    "mysqlnd",
    "openssl",
    "pcre",
    "PDO",
    "pdo_mysql",
    "Phar",
    "SimpleXML",
    "sodium",
    "standard",
    "tokenizer",
    "xml",
    "xmlreader",
    "xmlwriter",
    "zip",
    "zlib"
  ],
  "intelephense.environment.includePaths": [
    "vendor",
    "web/core"
  ],

  // =========================
  // Drupal: fichiers & associations
  // =========================
  "files.associations": {
    "*.module": "php",
    "*.install": "php",
    "*.inc": "php",
    "*.profile": "php",
    "*.theme": "php",
    "*.engine": "php"
  },

  // =========================
  // Exclusions pour recherche/FS watcher
  // =========================
  "files.exclude": {
    "**/.ddev/.dbimageBuild": true,
    "**/vendor": true,
    "**/node_modules": true
  },
  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/sites/default/files": true,
    "**/sites/*/files": true,
    "**/web/core": true
  },
  "files.watcherExclude": {
    "**/vendor/**": true,
    "**/node_modules/**": true,
    "**/sites/default/files/**": true,
    "**/sites/*/files/**": true,
    "**/web/core/**": true
  },

  // =========================
  // Terminal
  // =========================
  "terminal.integrated.defaultProfile.linux": "bash"
}